Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /index.html

RewriteEngine On
RewriteRule ^(\.git|README\.md) - [F,L]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Anciennes adresses du site WordPress
RewriteRule ^(dipyze-en-image|dipyze-en-musique|mentions-legales)/?$ / [L,R=301]
RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|old)(/.*)?$ / [L,R=301]

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
